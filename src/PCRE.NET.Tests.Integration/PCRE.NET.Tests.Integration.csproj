<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(PcreNetIntegrationTestNetFramework)' != ''">$(PcreNetIntegrationTestNetFramework)</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>PCRE.Tests.Integration</RootNamespace>
    <OutputType>Exe</OutputType>
    <ControlFlowGuard>Guard</ControlFlowGuard>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PcreNetIntegrationTestNetFramework)' == ''">
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <UseCurrentRuntimeIdentifier>true</UseCurrentRuntimeIdentifier>
    <!-- <PreferNativeArm64>true</PreferNativeArm64> TODO: Add .NET Framework integration tests -->
  </PropertyGroup>

  <!-- Integration Test Mode -->

  <Import Project="../Version.props" Condition="'$(PcreNetIntegrationTest)' == 'true'" />

  <PropertyGroup Condition="'$(PcreNetIntegrationTest)' == 'true'">
    <DefineConstants>$(DefineConstants);PCRENET_INTEGRATION_TEST</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(PcreNetIntegrationTest)' == 'true'">
    <PackageReference Include="PCRE.NET" Version="[$(Version)]" />
  </ItemGroup>

  <!-- Local Test Mode -->

  <ItemGroup Condition="'$(PcreNetIntegrationTest)' != 'true'">
    <ProjectReference Include="../PCRE.NET/PCRE.NET.csproj" />
    <ProjectReference Include="../PCRE.NET.Analyzers/PCRE.NET.Analyzers.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>

  <Import Project="../PCRE.NET/Build/PCRE.NET.targets" Condition="'$(PcreNetIntegrationTest)' != 'true'" />

</Project>
