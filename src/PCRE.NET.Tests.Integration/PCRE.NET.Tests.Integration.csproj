<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>PCRE.Tests.Integration</RootNamespace>
    <OutputType>Exe</OutputType>
    <ControlFlowGuard>Guard</ControlFlowGuard>
  </PropertyGroup>

  <PropertyGroup Condition="'$([MSBuild]::GetTargetFrameworkIdentifier($(TargetFramework)))' == '.NETCoreApp'">
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <UseCurrentRuntimeIdentifier>true</UseCurrentRuntimeIdentifier>
  </PropertyGroup>

  <!-- Full integration test mode: use the PCRE.NET NuGet package -->

  <PropertyGroup Condition="'$(UsePcreNetNuGetPackage)' == 'true'">
    <DefineConstants>$(DefineConstants);PCRENET_NUGET</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(UsePcreNetNuGetPackage)' == 'true'">
    <PackageReference Include="PCRE.NET" Version="[$(Version)]" />
  </ItemGroup>

  <!-- Local test mode: use project references -->

  <ItemGroup Condition="'$(UsePcreNetNuGetPackage)' != 'true'">
    <ProjectReference Include="../PCRE.NET/PCRE.NET.csproj" />
    <ProjectReference Include="../PCRE.NET.Analyzers/PCRE.NET.Analyzers.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>

  <Import Project="../PCRE.NET/Build/PCRE.NET.targets" Condition="'$(UsePcreNetNuGetPackage)' != 'true'" /> <!-- Only used to set the analyzer properties -->

</Project>
