<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;$(NetFrameworkTarget)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>PCRE.Benchmarks</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);BenchmarkDotNet.Artifacts/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <UseCurrentRuntimeIdentifier Condition="'$(TargetFramework)' != '$(NetFrameworkTarget)'">true</UseCurrentRuntimeIdentifier>
    <PreferNativeArm64 Condition="'$(TargetFramework)' == '$(NetFrameworkTarget)'">true</PreferNativeArm64>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PcreNetTestBuild)' != 'true'">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\PCRE.NET.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PCRE.NET\PCRE.NET.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet"/>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <!-- Needed for binding redirects -->
    <PackageReference Include="System.Reflection.Metadata" VersionOverride="10.0.11" />
  </ItemGroup>

</Project>
