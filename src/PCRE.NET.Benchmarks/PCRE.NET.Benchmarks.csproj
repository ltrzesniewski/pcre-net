<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net481</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>PCRE.Benchmarks</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);BenchmarkDotNet.Artifacts/**</DefaultItemExcludes>
    <PreferNativeArm64 Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">true</PreferNativeArm64>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PcreNetTestBuild)' != 'true'">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\PCRE.NET.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PCRE.NET\PCRE.NET.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <!-- Needed for binding redirects -->
    <PackageReference Include="System.Reflection.Metadata" Version="10.0.8" />

    <PcreNetNative Include="..\..\lib\PCRE.NET.Native.x86.dll" />
    <PcreNetNative Include="..\..\lib\PCRE.NET.Native.x64.dll" />
    <PcreNetNative Include="..\..\lib\PCRE.NET.Native.arm64.dll" />

    <PcreNetNative Update="@(PcreNetNative)" Exists="$([System.IO.File]::Exists('%(FullPath)'))" Visible="false" />

    <None Include="@(PcreNetNative->WithMetadataValue('Exists', 'true'))"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
